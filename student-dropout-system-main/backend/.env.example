# Server Configuration
PORT=3000

# Database Configuration (PostgreSQL)
# When PostgreSQL is not available, the backend automatically uses persistent local storage
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_dropout_db

# Machine Learning API URL
ML_API_URL=http://127.0.0.1:5000

# Google Gemini API Key for Academic Counselor Chatbot
# Get an API key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# JWT Secret Key for token generation
JWT_SECRET=super_secret_eduguard_jwt_key_2026
